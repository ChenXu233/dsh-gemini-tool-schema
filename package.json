{
  "name": "dsh-gemini-tool-schema",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin — normalize tool schemas into the strict OpenAPI 3.0 subset that Gemini function declarations accept (fixes HTTP 400 on MCP and built-in tools).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "gemini",
    "function-calling",
    "tool-schema",
    "json-schema",
    "openapi",
    "mcp"
  ],
  "license": "MIT",
  "author": "ChenXu233",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "default": "./dist/normalize.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/normalize.test.ts test/plugin.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenXu233/dsh-gemini-tool-schema.git"
  },
  "homepage": "https://github.com/ChenXu233/dsh-gemini-tool-schema#readme",
  "bugs": {
    "url": "https://github.com/ChenXu233/dsh-gemini-tool-schema/issues"
  }
}
